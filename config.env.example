# Copy to config.env for local development.
# Keep real values out of version control.
NODE_ENV=development
PORT=3002
DATABASE_PASSWORD=replace-with-mongodb-password
URI=replace-with-database-uri
MONGODB_URL=replace-with-mongodb-url
TRIPADVISORAPI=replace-with-tripadvisor-api-key
GOOGLEAPI=replace-with-google-api-key
SERPAPIKEY=replace-with-serpapi-key
JWT_TOKEN=replace-with-a-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
EMAIL_PASSWORD=replace-with-email-app-password
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
